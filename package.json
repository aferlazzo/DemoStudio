{
  "name": "demo-maker",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/core.test.mjs test/export.test.mjs test/reel.test.mjs",
    "test:piper": "node --test test/piper.test.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "electron": "42.0.0",
    "electron-builder": "26.15.0"
  },
  "main": "desktop/main.cjs",
  "description": "Local narrated application demonstrations and vertical Reels",
  "author": "Anthony Ferlazzo",
  "build": {
    "appId": "com.anthonyferlazzo.demomaker",
    "productName": "demoMaker",
    "artifactName": "demoMaker-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "public/**",
      "docs/**",
      "examples/**",
      "server.mjs",
      "media.mjs",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "extraResources": [
      {
        "from": ".local",
        "to": "speech"
      },
      {
        "from": "scripts/narrate.py",
        "to": "scripts/narrate.py"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "demoMaker",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
